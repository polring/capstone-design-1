#!/usr/bin/env bash
# Download a model release from the training repository and verify it.
#   scripts/fetch-model stage1-contract2 [output_dir]   (default output: models/<tag>/)
set -euo pipefail

REPOSITORY="polring/capstone-design-1"
FILES=(model.gguf model_info.json shop.db SHA256SUMS)

if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "usage: $0 TAG [OUTPUT_DIR]" >&2
    exit 2
fi
tag="$1"
output="${2:-models/$tag}"

mkdir -p "$output"
for file in "${FILES[@]}"; do
    curl -fsSL -o "$output/$file" \
        "https://github.com/$REPOSITORY/releases/download/$tag/$file"
done

cd "$output"
if command -v sha256sum >/dev/null; then
    sha256sum -c SHA256SUMS
else
    shasum -a 256 -c SHA256SUMS
fi
echo "saved $output"
