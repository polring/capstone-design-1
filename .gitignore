# Virtual Environments
.venv/
venv/
ENV/
env/

# Python caches and compiled files
__pycache__/
*.py[cod]
*$py.class

# IDEs and Editors
.vscode/
.idea/
.vs/
out/
build/
*.swp
*.swo

# Pytest
.pytest_cache/

# Data artifacts & raw outputs
data_raw/
data/**/data_raw/

# Local compiled binaries
normalizer.log
*.exe
*.obj
*.o
*.a
*.gguf
*.pt
*.pth

# GGUF 계약 fixture (C 엔진 테스트용 작은 모델)는 커밋한다
!tests/fixtures/contract/**/*.gguf

# Model files (except for stage models)
!models/stage*/model.pt

# 학습 산출물 (체크포인트, TensorBoard 로그)
runs/

# 의미론적 교정 캐시 및 원본 워드 임베딩
*.pkl
semantic_dict_*
glove.6B.*

# 로컬 실험 코드·실험 전용 테스트·산출물 — 공유할 결과는 단계별 보고서에 기록
experiments/

# Local agent settings and scheduler locks
.claude/settings.local.json
.claude/scheduled_tasks.lock
