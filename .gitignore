# Virtual Environments
.venv/
venv/
ENV/
env/

# Python caches and compiled files
__pycache__/
*.py[cod]
*$py.class

# IDEs and Editors
.vscode/
.idea/
.vs/
out/
build/
*.swp
*.swo

# Pytest
.pytest_cache/

# Data artifacts & raw outputs
data_raw/
data/**/data_raw/

# Local compiled binaries
*.exe
*.obj
*.o
*.a
*.gguf
*.pt
*.pth

# GGUF 계약 fixture (C 엔진 테스트용 작은 모델)는 커밋한다
!cli/fixtures/**/*.gguf

# C 후처리기 빌드 결과 (확장자 없는 실행 파일)
cli/postprocessor/postprocessor
cli/postprocessor/test_postprocessor

# Model files (except for stage models)
!models/stage*/model.pt

# 약한/대체 모델(예: Qwen3-14B) 파일럿 테스트용 임시 폴더 — 정식 채택 전까지는 커밋 안 함
qwen3_14b_test/

# 학습 산출물 (체크포인트, TensorBoard 로그)
runs/

# 의미론적 교정 캐시 및 원본 워드 임베딩
*.pkl
semantic_dict_*
glove.6B.*

